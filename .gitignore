# Ignore directory - for local files that should not be tracked
.ignore/

# Project config - user-specific (template: config.example.json)
config.json

# Trusted reviewers allowlist - user-specific
scripts/trusted-reviewers.txt

# Generated by `make setup` / `make link-agents`: symlinks from agents/ into each tool's
# discovery dir, and the Codex agent files converted from agents/agents/. The source of
# truth is agents/, so these are derived state and never committed. (.claude/ also holds
# the user-specific settings.local.json.)
.claude/
.agents/
.bravebot/
.cursor/
.codex/
/AGENTS.md

# Virtualenv made by `make setup`
.venv/

# Backup files
*.backup
*.bak

# Log files
*.log
logs/

# Temporary files
*.tmp
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.iml

# direnv
.envrc

__pycache__
*.egg-info/
.pytest_cache/
.ruff_cache/
